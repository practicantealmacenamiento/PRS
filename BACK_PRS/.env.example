# ============================================
# CONFIGURACIÓN DE DJANGO
# ============================================

# Clave secreta de Django (CAMBIAR EN PRODUCCIÓN)
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Modo de depuración (True para desarrollo, False para producción)
DEBUG=True

# Hosts permitidos (separados por comas)
# Desarrollo: localhost,127.0.0.1
# Producción: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================

# Orígenes permitidos para peticiones CORS (separados por comas)
# Desarrollo: http://localhost:3000,http://127.0.0.1:3000
# Producción: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# BASE DE DATOS (OPCIONAL)
# ============================================

# Por defecto usa SQLite. Para PostgreSQL, descomentar y configurar:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/radiofrecuencias

# Para MySQL:
# DATABASE_URL=mysql://usuario:contraseña@localhost:3306/radiofrecuencias

# ============================================
# JWT (JSON Web Tokens)
# ============================================

# Duración del token de acceso (en horas)
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8

# Duración del token de refresh (en días)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
